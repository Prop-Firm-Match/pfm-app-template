// jsdom doesn't implement ResizeObserver, which recharts' ResponsiveContainer
// (src/components/ui/chart.tsx) needs to mount at all -- without this stub,
// any test that renders a chart throws "ResizeObserver is not defined".
class ResizeObserverStub {
  observe() {}
  unobserve() {}
  disconnect() {}
}

globalThis.ResizeObserver ??= ResizeObserverStub;

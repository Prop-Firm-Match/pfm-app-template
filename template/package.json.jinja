{%- set deps = [] -%}
{%- set devDeps = [] -%}
{%- set scripts = [] -%}

{#- vite -- the only framework flavor -#}
{%- set _ = deps.append('"react": "19.2.8"') -%}
{%- set _ = deps.append('"react-dom": "19.2.8"') -%}
{%- set _ = devDeps.append('"@vitejs/plugin-react": "^6.1.0"') -%}
{%- set _ = devDeps.append('"vite": "catalog:"') -%}
{%- set _ = devDeps.append('"vite-plus": "catalog:"') -%}
{%- set _ = devDeps.append('"@cloudflare/vite-plugin": "^1.54.0"') -%}
{%- set _ = scripts.append('"dev": "vp dev"') -%}
{%- set _ = scripts.append('"build": "tsc -b && vp build && node scripts/strip-dev-vars.mjs"') -%}
{%- set _ = scripts.append('"preview": "vp preview"') -%}
{%- set _ = scripts.append('"predeploy": "node scripts/check-deploy-config.mjs"') -%}

{#- design system peer deps, always -#}
{%- set _ = deps.append('"@radix-ui/react-slot": "^1.3.3"') -%}
{%- set _ = deps.append('"@radix-ui/react-label": "^2.1.15"') -%}
{%- set _ = deps.append('"@radix-ui/react-select": "^2.3.7"') -%}
{%- set _ = deps.append('"class-variance-authority": "^0.7.1"') -%}
{%- set _ = deps.append('"clsx": "^2.1.1"') -%}
{%- set _ = deps.append('"tailwind-merge": "^3.6.0"') -%}
{%- set _ = deps.append('"lucide-react": "^1.34.0"') -%}
{%- set _ = devDeps.append('"tailwindcss": "^3.4.19"') -%}
{%- set _ = devDeps.append('"tailwindcss-animate": "^1.0.7"') -%}
{%- set _ = devDeps.append('"@tailwindcss/typography": "^0.5.20"') -%}
{%- set _ = devDeps.append('"postcss": "^8.5.26"') -%}
{%- set _ = devDeps.append('"autoprefixer": "^10.5.4"') -%}
{%- set _ = devDeps.append('"@types/react": "^19.2.18"') -%}
{%- set _ = devDeps.append('"@types/react-dom": "^19.2.5"') -%}

{#- forms + tables, always (part of the vendored design system) -#}
{%- set _ = deps.append('"react-hook-form": "^7.86.0"') -%}
{%- set _ = deps.append('"@hookform/resolvers": "^5.9.1"') -%}
{%- set _ = deps.append('"zod": "4.4.3"') -%}
{%- set _ = deps.append('"@tanstack/react-table": "^8.21.3"') -%}

{#- charts, always available (recharts is tree-shaken out if chart.tsx is never imported) -#}
{%- set _ = deps.append('"recharts": "^2.14.1"') -%}

{#- API layer: tRPC, always (this app's own API, regardless of data_source) -#}
{%- set _ = deps.append('"@trpc/server": "11.18.0"') -%}
{%- set _ = deps.append('"@trpc/client": "11.18.0"') -%}
{%- set _ = deps.append('"@trpc/react-query": "11.18.0"') -%}
{%- set _ = deps.append('"@tanstack/react-query": "^5.102.6"') -%}
{%- set _ = deps.append('"superjson": "^2.2.6"') -%}

{#- data_source -#}
{%- if data_source == "postgres" -%}
  {%- set _ = deps.append('"drizzle-orm": "^0.45.2"') -%}
  {%- set _ = deps.append('"pg": "^8.23.0"') -%}
  {%- set _ = devDeps.append('"drizzle-kit": "^0.31.10"') -%}
  {%- set _ = devDeps.append('"@types/pg": "^8.23.1"') -%}
{%- elif data_source == "bigquery" -%}
  {%- set _ = deps.append('"@google-cloud/bigquery": "^7.9.4"') -%}
{%- endif -%}

{#- auth -#}
{%- if auth == "clerk" -%}
  {%- set _ = deps.append('"@clerk/clerk-react": "5.61.8"') -%}
  {%- set _ = deps.append('"@clerk/backend": "^3.16.12"') -%}
{%- elif auth == "google-oauth" or auth == "cloudflare-access" -%}
  {%- set _ = deps.append('"jose": "^6.2.10"') -%}
{%- endif -%}

{#- optional toggles -#}
{%- if enable_i18n -%}
  {%- set _ = deps.append('"react-i18next": "^17.0.12"') -%}
  {%- set _ = deps.append('"i18next": "^26.4.0"') -%}
{%- endif -%}
{%- if enable_file_storage -%}
  {%- set _ = deps.append('"@aws-sdk/client-s3": "^3.1118.0"') -%}
{%- endif -%}
{%- if enable_testing -%}
  {%- set _ = devDeps.append('"vitest": "catalog:"') -%}
  {%- set _ = devDeps.append('"@testing-library/react": "^16.3.2"') -%}
  {%- set _ = devDeps.append('"jsdom": "^29.1.1"') -%}
  {%- set _ = scripts.append('"test": "vp test run"') -%}
{%- endif -%}
{%- if enable_storybook -%}
  {%- set _ = devDeps.append('"storybook": "^10.5.10"') -%}
  {%- set _ = devDeps.append('"@storybook/react-vite": "^10.5.10"') -%}
  {%- set _ = scripts.append('"storybook": "storybook dev -p 6006"') -%}
  {%- set _ = scripts.append('"build-storybook": "storybook build"') -%}
{%- endif -%}

{#- always -#}
{%- set _ = devDeps.append('"typescript": "^7.0.2"') -%}
{%- set _ = devDeps.append('"@types/node": "^24.13.3"') -%}
{%- set _ = devDeps.append('"wrangler": "^4.114.0"') -%}
{%- set _ = devDeps.append('"@cloudflare/workers-types": "^5.20260728.1"') -%}
{%- set _ = scripts.append('"lint": "vp lint ."') -%}
{%- set _ = scripts.append('"type-check": "tsc --noEmit"') -%}
{%- set _ = scripts.append('"format": "vp fmt ."') -%}
{%- set _ = scripts.append('"format:check": "vp fmt --check ."') -%}
{%- set _ = scripts.append('"prepare": "vp config --no-agent"') -%}
{%- if data_source == "postgres" -%}
  {%- set _ = scripts.append('"db:generate": "drizzle-kit generate"') -%}
  {%- set _ = scripts.append('"db:migrate": "drizzle-kit migrate"') -%}
{%- endif -%}
{
  "name": "{{ project_name }}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    {{ scripts | join(',\n    ') }}
  },
  "dependencies": {
    {{ deps | sort | join(',\n    ') }}
  },
  "devDependencies": {
    {{ devDeps | sort | join(',\n    ') }}
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@10.26.1"
}

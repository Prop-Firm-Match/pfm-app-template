'use client';

import { useEffect, type ReactNode } from 'react';
import {
  ClerkProvider,
  RedirectToSignIn,
  SignedIn,
  SignedOut,
  useAuth,
  useUser,
} from '@clerk/clerk-react';

import { setTokenGetter } from './token-store';

{%- if deploy_target == "vercel" %}
// NEXT_PUBLIC_ -- Next.js only inlines env vars into the client bundle
// under this prefix (mirrors Vite's VITE_ convention for the other
// deploy_target).
const publishableKey = process.env.NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY as string;
{%- else %}
const publishableKey = import.meta.env.VITE_CLERK_PUBLISHABLE_KEY as string;
{%- endif %}

function TokenBridge() {
  const { getToken } = useAuth();
  useEffect(() => {
    setTokenGetter(() => getToken());
  }, [getToken]);
  return null;
}

export function AuthGate({ children }: { children: ReactNode }) {
  return (
    <ClerkProvider publishableKey={publishableKey}>
      <SignedIn>
        <TokenBridge />
        {children}
      </SignedIn>
      <SignedOut>
        <RedirectToSignIn />
      </SignedOut>
    </ClerkProvider>
  );
}

export function useAuthIdentity() {
  const { user } = useUser();
  return { email: user?.primaryEmailAddress?.emailAddress ?? null };
}

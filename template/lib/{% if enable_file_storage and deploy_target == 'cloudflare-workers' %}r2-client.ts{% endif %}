// enable_file_storage=true — R2 (S3-compatible) file uploads, matching
// propfirm's use of R2 for object storage. Bucket binding is configured in
// the CF dashboard when the repo is connected (Workers Builds).
import { S3Client } from '@aws-sdk/client-s3';

export function getR2Client() {
  return new S3Client({
    region: 'auto',
    endpoint: process.env.R2_ENDPOINT,
    credentials: {
      accessKeyId: process.env.R2_ACCESS_KEY_ID ?? '',
      secretAccessKey: process.env.R2_SECRET_ACCESS_KEY ?? '',
    },
  });
}

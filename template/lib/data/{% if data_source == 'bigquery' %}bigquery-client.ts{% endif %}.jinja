// data_source=bigquery — no existing propfirm precedent for this; net-new
// adapter. Credentials come from a dashboard-configured secret at
// deploy-time (see README "Secrets" section).
import { BigQuery } from '@google-cloud/bigquery';

{%- if deploy_target == "cloudflare-workers" %}
// Workers don't populate `process.env` from dashboard secrets, so these
// must come through the Worker's own `env` binding, not `process.env`.
interface Env {
  BIGQUERY_PROJECT_ID?: string;
  BIGQUERY_SERVICE_ACCOUNT_JSON?: string;
}

export function getBigQueryClient(env: Env) {
  return new BigQuery({
    projectId: env.BIGQUERY_PROJECT_ID,
    credentials: JSON.parse(env.BIGQUERY_SERVICE_ACCOUNT_JSON ?? '{}'),
  });
}
{%- else %}
// process.env, not an env binding -- Vercel populates it from
// dashboard-configured env vars directly.
let client: BigQuery | undefined;

export function getBigQueryClient() {
  client ??= new BigQuery({
    projectId: process.env.BIGQUERY_PROJECT_ID,
    credentials: JSON.parse(process.env.BIGQUERY_SERVICE_ACCOUNT_JSON ?? '{}'),
  });
  return client;
}
{%- endif %}

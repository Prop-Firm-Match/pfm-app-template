# Copy to .env for local development (`pnpm dev` picks it up via Vite).
# These are LOCAL DEV values only -- production secrets are set in the
# Cloudflare dashboard when connecting the repo (Workers Builds), not here.
# See README.md "Secrets" for the full deploy-time list.

{%- if data_source == "postgres" %}

# data_source=postgres -- matches docker-compose.yml's postgres service.
DATABASE_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/{{ project_name | replace("-", "_") }}
{%- endif %}
{%- if data_source == "bigquery" %}

# data_source=bigquery
BIGQUERY_PROJECT_ID=
BIGQUERY_SERVICE_ACCOUNT_JSON=
{%- endif %}
{%- if data_source == "google-sheets" %}

# data_source=google-sheets -- same service account pattern as financial-dashboard
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
{%- endif %}
{%- if auth == "clerk" %}

# auth=clerk -- from your Clerk dashboard (test/dev instance)
VITE_CLERK_PUBLISHABLE_KEY=
# server-side, used by lib/auth/verify-identity.ts to verify the session token
CLERK_SECRET_KEY=
{%- endif %}
{%- if auth == "google-oauth" %}

# auth=google-oauth -- OAuth client from Google Cloud Console
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_WORKSPACE_DOMAIN=
# server-side copies, used by lib/auth/verify-identity.ts to verify the ID token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=
{%- endif %}
{%- if auth == "cloudflare-access" %}

# auth=cloudflare-access -- nothing to set locally. Running `pnpm dev`
# without going through CF Access means no Cf-Access-Jwt-Assertion header,
# so the nav just won't show a signed-in email -- everything else works.
{%- endif %}
{%- if enable_file_storage %}

# enable_file_storage=true
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
{%- endif %}

// data_source=postgres — mirrors propfirm's packages/pfm-db/drizzle.config.ts.
// drizzle-kit is a Node CLI, not a Worker -- it has no access to the
// HYPERDRIVE binding lib/db/client.ts uses at runtime, so it needs its own
// connection string here.
import { defineConfig } from 'drizzle-kit';

export default defineConfig({
  dialect: 'postgresql',
  schema: './lib/db/schema.ts',
  out: './drizzle',
  dbCredentials: {
    url:
      process.env.DATABASE_CONNECTION_STRING ??
      'postgres://postgres:postgres@localhost:5432/{{ project_name | replace("-", "_") }}',
  },
});

import type { Preview } from '@storybook/react-vite';
import '../src/styles/globals.css';

// PFM is dark-by-default -- match the real app shell so components preview
// against the correct canvas instead of a plain white Storybook background.
const preview: Preview = {
  parameters: {
    backgrounds: {
      default: 'pfm-dark',
      values: [{ name: 'pfm-dark', value: 'hsl(330 6.7% 5.9%)' }],
    },
  },
  decorators: [
    (Story) => (
      <div className="dark bg-background p-8">
        <Story />
      </div>
    ),
  ],
};

export default preview;
